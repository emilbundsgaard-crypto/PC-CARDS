# Copy this file to .env.local and paste in your key.
# .env.local is gitignored — never commit the real key.
#
# Get a FREE key at https://aistudio.google.com/apikey
# (a Google account is enough; no payment method required)
GEMINI_API_KEY=

# Optional — override the model. Defaults to gemini-3.6-flash.
# Google retires models for new keys; if you get a 404, the error names the
# replacement — set it here rather than editing the source.
# GEMINI_MODEL=gemini-3.6-flash
